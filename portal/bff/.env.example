# BFF Server Configuration
PORT=4000
BFF_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# OIDC / Keycloak Configuration (Production BFF Authorization Code + PKCE flow)
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_INTERNAL_URL=http://localhost:8180
KEYCLOAK_REALM=ikeda
KEYCLOAK_CLIENT_ID=tenant-portal-bff
KEYCLOAK_CLIENT_SECRET=ikeda-tenant-portal-bff-secret-2026
SESSION_COOKIE_NAME=ikeda_bff_session

# Optional Platform Admin API Key (used ONLY by src/routes/settings.ts to read/update
# tenant branding & config in identity-api on behalf of authenticated tenant:admin users)
# PLATFORM_ADMIN_API_KEY=

# Optional GCP Cloud Run IAM auth (enable ONLY on Cloud Run; keep false locally or on K3s)
GCP_IAM_AUTH=false

# Upstream Rust Microservices URLs
EVENTS_API_URL=http://localhost:8080
CRM_API_URL=http://localhost:8081
IDENTITY_API_URL=http://localhost:8082
CATALOG_API_URL=http://localhost:8083
BOOKINGS_API_URL=http://localhost:8084
TELEMETRY_API_URL=http://localhost:8085
CONTENT_API_URL=http://localhost:8086
MEDIA_API_URL=http://localhost:8087
