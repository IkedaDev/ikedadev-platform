# ==============================================================================
# IkedaDev Content API (Headless CMS) — Environment Variables
# ==============================================================================
HOST=0.0.0.0
PORT=8086
LOG_FORMAT=pretty
RUST_LOG=info,content_api=debug,sqlx=warn,tower_http=info

# PostgreSQL (ALWAYS connect with NOBYPASSRLS role `ikeda_app`, NEVER `postgres`)
DATABASE_URL=postgres://ikeda_app:ikeda_app_password@localhost:5432/content_db?sslmode=disable
IDENTITY_DATABASE_URL=postgres://ikeda_app:ikeda_app_password@localhost:5432/identity_db?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1

# Keycloak / OIDC JWKS JWT Validation
JWKS_URI=http://localhost:8180/realms/ikeda/protocol/openid-connect/certs
JWT_ISSUER=http://localhost:8180/realms/ikeda
# JWT_AUDIENCE=

# Draft Preview Token Signing Secret (HMAC-SHA256; set a strong random secret in QA/Prod)
PREVIEW_TOKEN_SECRET=dev-preview-token-secret-change-in-production

# Allow http:// image/SEO URLs in local development (set false in production)
ALLOW_INSECURE_HTTP_URLS=true

# Cloudflare R2 / S3-compatible Object Storage (leave empty for No-op dev adapter)
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://media.example.com
# R2_ENDPOINT_URL=

# Upstash QStash Scheduled Publishing & Deploy Hooks (leave empty for No-op dev adapter)
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_BASE_URL=https://qstash.upstash.io/v2/publish
# PUBLIC_BASE_URL=https://content-api.example.com
