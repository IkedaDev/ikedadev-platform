HOST=0.0.0.0
PORT=8082
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/identity_db?sslmode=disable
RUST_LOG=info,identity_api=debug,tower_http=debug

# Keycloak Admin REST API (client_credentials service account — override in production)
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=ikeda
KEYCLOAK_CLIENT_ID=identity-api-admin
KEYCLOAK_CLIENT_SECRET=ikeda-identity-admin-secret-2026

# Optional Keycloak / OIDC JWKS Validation
# JWKS_URI=http://localhost:8180/realms/ikeda/protocol/openid-connect/certs
# JWT_ISSUER=http://localhost:8180/realms/ikeda
# JWT_AUDIENCE=account
