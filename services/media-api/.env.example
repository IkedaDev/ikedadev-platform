# ==============================================================================
# IkedaDev Media API (Transversal Media Service) — Environment Variables
# ==============================================================================
HOST=0.0.0.0
PORT=8087
LOG_FORMAT=pretty
RUST_LOG=info,media_api=debug,sqlx=warn,tower_http=info

# PostgreSQL (ALWAYS connect with NOBYPASSRLS role `ikeda_app`, NEVER `postgres`)
DATABASE_URL=postgres://ikeda_app:ikeda_app_password@localhost:5432/media_db?sslmode=disable
IDENTITY_DATABASE_URL=postgres://ikeda_app:ikeda_app_password@localhost:5432/identity_db?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1

# Keycloak / OIDC JWKS JWT Validation
JWKS_URI=http://localhost:8180/realms/ikeda/protocol/openid-connect/certs
JWT_ISSUER=http://localhost:8180/realms/ikeda
# JWT_AUDIENCE=

# Tenant Default Quotas (bytes)
DEFAULT_MAX_STORAGE_BYTES=524288000
DEFAULT_MAX_FILE_SIZE_BYTES=5242880

# Cloudflare R2 / S3-compatible Object Storage (Production & QA)
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://media.example.com
# R2_ENDPOINT_URL=

# Local Development Fallback (ONLY set true in local dev; MUST be false in QA/Prod)
ALLOW_LOCAL_MEDIA_STORAGE=true
LOCAL_MEDIA_BASE_URL=http://localhost:8087/v1/media/local
LOCAL_MEDIA_DIR=/tmp/ikeda-media-local
LOCAL_MEDIA_SIGNING_SECRET=dev-local-media-hmac-secret-change-me
LOCAL_CORS_ORIGIN=http://localhost:5173
