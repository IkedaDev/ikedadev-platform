# IkedaDev Platform - Events API Environment Configuration

# Server
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
RUST_LOG=info,events_api=debug,ikeda_core=debug,tower_http=debug

# PostgreSQL / Neon Database (supports poolers like PgBouncer)
# For Neon: postgres://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/events_db?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Optional centralized API Key validation against identity_db (falls back to DATABASE_URL if unset)
# In production (Neon), use a least-privilege role with EXECUTE only on authenticate_api_key(VARCHAR)
IDENTITY_DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/identity_db?sslmode=disable

# Optional Keycloak / OIDC JWKS Validation
# JWKS_URI=http://localhost:8180/realms/ikeda/protocol/openid-connect/certs
# JWT_ISSUER=http://localhost:8180/realms/ikeda
# JWT_AUDIENCE=account

# Upstash QStash (Phase 5)
QSTASH_URL=https://qstash.upstash.io/v2
QSTASH_TOKEN=your-qstash-token-here
QSTASH_CURRENT_SIGNING_KEY=your-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key
