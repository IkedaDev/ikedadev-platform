HOST=0.0.0.0
PORT=8083
DATABASE_URL=postgres://ikeda_app:ikeda_app_password@localhost:5432/catalog_db?sslmode=disable
# Optional centralized API Key validation against identity_db (falls back to DATABASE_URL if unset)
IDENTITY_DATABASE_URL=postgres://ikeda_app:ikeda_app_password@localhost:5432/identity_db?sslmode=disable
RUST_LOG=info,catalog_api=debug,tower_http=debug

# Optional Keycloak / OIDC JWKS Validation
# JWKS_URI=http://localhost:8180/realms/ikeda/protocol/openid-connect/certs
# JWT_ISSUER=http://localhost:8180/realms/ikeda
# JWT_AUDIENCE=account

# Allow http:// image URLs only in local development (e.g. LocalDevObjectStorage on localhost:8087)
ALLOW_INSECURE_HTTP_URLS=true
