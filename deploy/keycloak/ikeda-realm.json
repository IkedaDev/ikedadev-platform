      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Demo Tenant",
      "attributes": {
        "tenant_id": ["11111111-1111-4111-8111-111111111111"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
